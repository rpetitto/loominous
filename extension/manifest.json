{
  "manifest_version": 3,
  "name": "Loominous",
  "short_name": "Loominous",
  "description": "Turn any Loom video into a beautiful cheat sheet. Extracts transcript and captures screenshots.",
  "version": "1.1.0",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "clipboardWrite", "windows"],
  "host_permissions": [
    "https://www.loom.com/*",
    "https://loominous.flingit.run/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Loominous — Generate Cheat Sheet"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.loom.com/share/*", "https://www.loom.com/embed/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://loominous.flingit.run/*", "http://localhost:3000/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
